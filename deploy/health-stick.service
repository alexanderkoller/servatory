[Unit]
Description=Health Stick server health display
# Keep reporting while Proxmox's native guest shutdown service runs. Shutdown
# ordering is the reverse of startup ordering, so pve-guests stops first.
Before=pve-guests.service
After=pve-cluster.service

[Service]
Type=simple
ExecStart=/usr/local/bin/health-stick-host --config /etc/health-stick/config.yaml
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
